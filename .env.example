# Supabase — omit to run in demo mode with in-memory seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing — omit to use the local demo entitlement grants.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Places sync (Supabase edge function secret, set via `supabase secrets set`).
GOOGLE_PLACES_API_KEY=
