# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model + runtime config (defaults shown)
RYDESHARE_MODEL=claude-opus-4-8
RYDESHARE_DATA_DIR=./data

# --- Microsoft 365 extraction service (src/microsoft/server.ts) ---
# Shared secret Power Automate sends as `x-umi-token`. Leave blank to disable auth.
UMI_EXTRACT_TOKEN=
# Port the service listens on (Azure sets this automatically).
PORT=8787
# Where the learning memory persists. Mount a volume here in Azure so it survives restarts.
UMI_MEMORY_PATH=./.umi/memory.json
# Optional model override for extraction only.
UMI_EXTRACT_MODEL=claude-opus-4-8
