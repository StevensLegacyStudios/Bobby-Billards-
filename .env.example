# ---- CarMan AI configuration ----
# Copy this file to `.env.local` and fill in your keys. `.env.local` is gitignored.

# Inventory provider: "auto" uses a real API if a key is present, otherwise falls
# back to bundled mock data so the app always runs. Force one with "autodev" or "mock".
INVENTORY_PROVIDER=auto

# Auto.dev vehicle listings API — free tier: 1,000 calls/month.
# Get a key at https://www.auto.dev  (leave blank to run on mock data)
AUTODEV_API_KEY=

# (Optional, future) Marketcheck API — larger inventory, paid.
# MARKETCHECK_API_KEY=

# Anthropic API — powers the AI advisor chat. Leave blank for templated advice.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model id for the advisor (defaults to claude-opus-4-8 if unset).
# Set to claude-sonnet-4-6 or claude-haiku-4-5 to trade quality for cost.
CARMAN_ADVISOR_MODEL=claude-opus-4-8
