{
  "name": "rydeshare",
  "version": "0.1.0",
  "private": true,
  "description": "AI Project Manager 'brain' for commercial plumbing tenant-improvement (TI) work — NorCal union crews. A local-first, Claude-powered conversational PM.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rydeshare": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e.ts",
    "serve:ms": "tsx src/microsoft/server.ts",
    "demo": "tsx scripts/demo.ts",
    "manual:pdf": "node scripts/build_manual_pdf.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "dotenv": "^16.4.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pdfkit": "^0.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
